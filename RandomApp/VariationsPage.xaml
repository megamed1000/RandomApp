<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RandomApp.VariationsPage"
             Title="VariationsPage">
    <ScrollView>
            <VerticalStackLayout>
        <Entry x:Name="minEntry" Placeholder="Minimum number"/>
        <Entry x:Name="maxEntry" Placeholder="Maximum number"/>
        <Entry x:Name="amountEntry" Placeholder="Amount"/>
        <Button Text="Generate" Clicked="OnGenerateClicked"/>
        <Label x:Name="resultLabel"/>
    </VerticalStackLayout>
    </ScrollView>

</ContentPage>