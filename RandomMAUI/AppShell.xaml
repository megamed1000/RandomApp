<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RandomMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RandomMAUI"
    Title="Random App">
    <TabBar>
        <Tab Title="Variations"
            Icon="variationicon.png">
            <ShellContent ContentTemplate="{DataTemplate local:VariationsPage}" />
        </Tab>
        <Tab Title="Probabilities"
            Icon="probabilityicon.png">
            <ShellContent ContentTemplate="{DataTemplate local:ProbabilityPage}" />
        </Tab>
    </TabBar>
</Shell>
